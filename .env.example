# Copy to `.env` next to docker-compose.yaml. The values below are the defaults.
# Local dev login is active; comment it out and uncomment another mode to switch.
# Compose interpolates `$` in values, so write a literal `$` as `$$`.


# =============================================================================
# DEPLOYMENT MODES - pick one
# =============================================================================
# There is no anonymous mode; the console refuses to start without one of these.

# --- a) Local dev: throwaway admin/admin and user/user, no Keycloak ----------
# Overrides CONSOLE_AUTH_TYPE. Never use this anywhere real.
SPRING_PROFILES_ACTIVE=localdev

# --- b) OAUTH2: `docker compose --profile keycloak up` -----------------------
# CONSOLE_AUTH_TYPE=OAUTH2
# KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/frank
# KEYCLOAK_CLIENT_ID=frank-confidential
# KEYCLOAK_CLIENT_SECRET=frank-confidential-secret
#
# The endpoints are read from the issuer's discovery document unless you set all four.
# Set them when discovery cannot be reached, or returns hostnames the browser cannot use.
# KEYCLOAK_AUTHORIZATION_URI=http://localhost:8081/realms/frank/protocol/openid-connect/auth
# KEYCLOAK_TOKEN_URI=http://localhost:8081/realms/frank/protocol/openid-connect/token
# KEYCLOAK_USERINFO_URI=http://localhost:8081/realms/frank/protocol/openid-connect/userinfo
# KEYCLOAK_JWKSET_URI=http://localhost:8081/realms/frank/protocol/openid-connect/certs
#
# Only read when the four above are set, and only needed for a non-Keycloak provider -
# otherwise it is derived from the issuer. Empty means logout leaves the provider's
# session alive, so the next login signs the same user straight back in.
# KEYCLOAK_END_SESSION_URI=

# --- c) Local accounts you provision yourself --------------------------------
# Index counts from 0 upwards and must be contiguous. Hash with:
#   htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
# CONSOLE_AUTH_TYPE=IN_MEMORY
# APPLICATION_SECURITY_CONSOLE_AUTHENTICATION_IN_MEMORY_USERS_0_USERNAME=admin
# APPLICATION_SECURITY_CONSOLE_AUTHENTICATION_IN_MEMORY_USERS_0_PASSWORD={bcrypt}$$2a$$10$$replace.me
# APPLICATION_SECURITY_CONSOLE_AUTHENTICATION_IN_MEMORY_USERS_0_ROLES=gateway-user,gateway-admin


# =============================================================================
# READ BY DOCKER-COMPOSE - setting these in .env works
# =============================================================================

# Backs the throughput and latency charts.
PROMETHEUS_URL=http://host.docker.internal:9090

# Gateway control API. Only seeds apisix_config.yaml on first start; after that it
# is edited from Connection Settings.
APISIX_HOST=http://host.docker.internal

# Set to false when there is no Loki. The dashboard then leaves out the messages counter,
# the traffic-per-route table and the log, queries nothing, and ignores the LOKI_* below.
LOKI_ENABLED=true

# Where the console reads the gateway access log. Point the loki-logger
# endpoint_addrs in config/apisix.yaml at the same Loki.
LOKI_URL=http://loki:3100

# X-Scope-OrgID, sent only when non-empty. Only matters on a multi-tenant Loki.
LOKI_TENANT_ID=

# Comma-separated namespaces to scope log queries to; empty means all. Must match
# loki-logger.log_labels.namespace in config/apisix.yaml ("local" here).
LOKI_NAMESPACE=

# The label/field carrying it, if a collector relabelled it.
LOKI_NAMESPACE_LABEL=namespace

# How far back "all" reaches, in hours. Match retention_period in config/loki.yaml.
# Too high is free; too low silently hides data Loki still holds.
LOKI_RETENTION_HOURS=336

# Pin repo, branch and file path server-side; the Git Settings panel goes read-only.
# Access tokens are not pinned - those stay per user.
GIT_SETTINGS_LOCKED=false

# Only read when GIT_SETTINGS_LOCKED=true.
#   GIT_PROVIDER      github, gitlab or gitea.
#   GIT_HOST          Instance URL for gitlab/gitea; leave empty for github.
#   GIT_REPO          owner/repo, or owner/project on gitlab.
#   GIT_BRANCH        e.g. main.
#   GIT_CONFIG_PATH   The one file users may read and write, as a path in the repo.
GIT_PROVIDER=github
GIT_HOST=
GIT_REPO=
GIT_BRANCH=
GIT_CONFIG_PATH=

# Optional service-account token, so nobody has to paste one into the console. Every
# commit is then authored by whoever owns this token, and everyone who can sign in can
# write with it - so scope it to the one repository above. Empty means each user brings
# their own, through their Keycloak link or a personal access token.
GIT_TOKEN=

# OAuth apps for the keycloak profile, so users link GitHub/GitLab instead of
# pasting a token. Callback: http://localhost:8081/realms/frank/broker/<alias>/endpoint
GITHUB_IDP_CLIENT_ID=
GITHUB_IDP_CLIENT_SECRET=
GITLAB_IDP_CLIENT_ID=
GITLAB_IDP_CLIENT_SECRET=

# Providers the realm brokers - Keycloak has no endpoint listing them.
# Empty hides the linking UI. OAUTH2 only.
GIT_BROKER_PROVIDERS=github,gitlab

# The apisix service loads this same file for HTTPS and the FSC/NLX plugin. Those
# names belong to the gateway image - see .env.example in wearefrank/frank-gateway.

# =============================================================================
# COMMENTED OUT IN DOCKER-COMPOSE - uncomment there first
# =============================================================================
# Setting these here does nothing until the matching line in docker-compose.yaml is
# uncommented. Under Helm, `docker run -e` or the bare jar they work as normal.

# Must match the ports mapping in docker-compose.yaml.
SERVER_PORT=8080

# Only seed apisix_config.yaml on first start, like APISIX_HOST.
APISIX_CONTROL_PORT=9882
APISIX_METRICS_PORT=9881

# Where that file is written, relative to WORKDIR /data.
APISIX_CONFIG_FILE=apisix_config.yaml

# The log table's columns, matching loki-logger's log_format.
LOG_FIELDS_FILE=/config/log-fields.yaml

# Needed behind a TLS-terminating proxy. Set to "none" when reached directly.
FORWARD_HEADERS_STRATEGY=framework

# The loadgen (compose profile `test`) does not read .env; its variables live in
# docker-compose.yaml.
